# === LLM Provider Configuration ===
# Options: "docker" (default, uses local model), "openai", or "groq"
LLM_PROVIDER=groq

# === OpenAI Configuration (required when LLM_PROVIDER=openai) ===
OPENAI_API_KEY=your_openai_api_key_here

# === Docker Model Runner Configuration (when LLM_PROVIDER=docker) ===
DOCKER_MODEL_URL=http://model-runner.docker.internal/engines/llama.cpp/v1/
DOCKER_MODEL_API_KEY=modelrunner
DOCKER_MODEL_NAME=ai/llama3.2:latest

# === Flask Configuration ===
# REQUIRED in production. The app refuses to start when FLASK_ENV=production
# or LLM_PROVIDER is a hosted provider (openai/groq) and SECRET_KEY is unset.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development a random key is used as fallback (sessions reset on restart).
SECRET_KEY=generate-a-strong-secret-key-here
# Optional: set FLASK_ENV=production to enforce SECRET_KEY presence.
# FLASK_ENV=production

# === CORS Configuration ===
CORS_ORIGINS=http://localhost:4001

# === Groq Configuration (when LLM_PROVIDER=groq) ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# === Mapbox (optional, enables satellite/dark map tiles) ===
MAPBOX_TOKEN=your_mapbox_public_token_here

# === Satellite API (optional, for cartography features) ===
SATELLITE_API_KEY=your_satellite_api_key_here
